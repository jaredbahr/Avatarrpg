{
  "name": "four-nations-tactics",
  "version": "0.2.10",
  "private": true,
  "description": "Four Nations Tactics - a hot-seat turn-based tactical RPG for the family. Non-commercial fan work.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vitest run src/core/sim",
    "balance": "node --import tsx scripts/balance.ts",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "ci:local": "node scripts/ci-local.mjs",
    "gallery": "npm run gallery:capture && node scripts/gallery-index.mjs",
    "gallery:capture": "playwright test -c playwright.gallery.config.ts",
    "art:normalise": "node --import tsx scripts/art/normalise.ts",
    "art:pack": "node --import tsx scripts/art/pack.ts",
    "art:validate": "node --import tsx scripts/art/validate.ts",
    "art:map": "node --import tsx scripts/art/map.ts",
    "art:map-pack": "node --import tsx scripts/art/map-pack.ts",
    "art:icons": "node --import tsx scripts/art/icons.ts",
    "art:portrait": "node --import tsx scripts/art/portrait.ts",
    "art:prop": "node --import tsx scripts/art/prop.ts",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "credits": "node --import tsx scripts/credits.ts"
  },
  "dependencies": {
    "pixi.js": "^8.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@iconify-json/game-icons": "^1.2.4",
    "@jsquash/webp": "^1.5.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.17.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "terser": "^5.51.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
